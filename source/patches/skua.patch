+/// Skua build: a borderless child of the given native window (`--skua-parent`).
+fn skua_child_of(attributes: WindowAttributes, parent: u64) -> WindowAttributes {
+    use winit::raw_window_handle::RawWindowHandle;
+    #[cfg(windows)]
+    let handle = std::num::NonZeroIsize::new(parent as isize)
+        .map(|hwnd| RawWindowHandle::Win32(winit::raw_window_handle::Win32WindowHandle::new(hwnd)));
+    #[cfg(all(unix, not(target_os = "macos")))]
+    let handle = Some(RawWindowHandle::Xlib(winit::raw_window_handle::XlibWindowHandle::new(
+        parent as _,
+    )));
+    #[cfg(target_os = "macos")]
+    let handle: Option<RawWindowHandle> = None; // ponytail: no embedding on macOS yet, own window
+    // SAFETY: VibeSkua keeps the parent window alive for as long as this player runs.
+    unsafe { attributes.with_parent_window(handle) }.with_decorations(false)
+}
