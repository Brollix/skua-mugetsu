index 00000000..850e6d7c
--- /dev/null
+++ b/desktop/src/skua.rs
@@ -0,0 +1,238 @@
+//! Skua build: lets Bonxie drive the game and show it inside its own window.
+//!
+//! With `--skua-bridge host:port` the player connects to Bonxie over TCP and both sides send one
+//! JSON object per line:
+//!
+//! - Bonxie -> player: `{"id":1,"name":"isLoggedIn","args":[]}` calls an `ExternalInterface`
+//!   callback of the movie, answered with `{"id":1,"r":...}`.
+//! - player -> Bonxie: `{"ev":"loaded","args":[...]}` for every `ExternalInterface.call` of
+//!   skua.swf (its `Externalizer` sends them all as `skuaCall(name, args)`).
+//!
+//! When Bonxie closes the connection the player exits. `--skua-parent <window handle>` makes the
+//! window a borderless child of that window.
+
+use crate::custom_event::RuffleEvent;
+use ruffle_core::context::UpdateContext;
+use ruffle_core::external::{ExternalInterfaceProvider, Value as ExternalValue};
+use serde_json::{Map, Number, Value as Json, json};
+use std::collections::VecDeque;
+use std::io::{BufRead, BufReader, Write};
+use std::net::TcpStream;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Mutex, OnceLock};
+use winit::event_loop::EventLoopProxy;
+
+/// A call from Bonxie, run on the main thread (see `MainWindow::run_skua_calls`).
+pub struct SkuaCall {
+    pub id: u64,
+    pub name: String,
+    pub args: Vec<ExternalValue>,
+}
+
+static ACTIVE: AtomicBool = AtomicBool::new(false);
+static WRITER: OnceLock<Mutex<TcpStream>> = OnceLock::new();
+static CALLS: Mutex<VecDeque<SkuaCall>> = Mutex::new(VecDeque::new());
+/// Whether a `SkuaWake` is posted or the main thread will look at `CALLS` anyway.
+///
+/// Windows only paints (and winit only reaches `about_to_wait`, where the game ticks) once a
+/// thread's message queue is empty, and every `EventLoopProxy::send_event` is a posted message.
+/// Bonxie calls the game nonstop, so one message per call kept the queue full and froze the game
+/// for up to seconds. Instead at most one wake is posted, and the main thread only asks for the next
+/// one in `about_to_wait`, after the queue (and painting) has run.
+static WAKE_PENDING: AtomicBool = AtomicBool::new(false);
+
+/// Set by `main::mugetsu_args` when started by Bonxie.
+pub fn set_active() {
+    ACTIVE.store(true, Ordering::Relaxed);
+}
+
+pub fn active() -> bool {
+    ACTIVE.load(Ordering::Relaxed)
+}
+
+/// Connects to Bonxie (once; later movies reuse the connection) and starts reading its calls.
+pub fn connect(addr: &str, event_loop: EventLoopProxy<RuffleEvent>) -> std::io::Result<()> {
+    if WRITER.get().is_some() {
+        return Ok(());
+    }
+    let stream = TcpStream::connect(addr)?;
+    stream.set_nodelay(true)?;
+    let reader = BufReader::new(stream.try_clone()?);
+    let _ = WRITER.set(Mutex::new(stream));
+
+    std::thread::Builder::new()
+        .name("skua bridge".to_string())
+        .spawn(move || {
+            for line in reader.lines() {
+                let Ok(line) = line else { break };
+                match parse_call(&line) {
+                    Some(call) => {
+                        lock(&CALLS).push_back(call);
+                        if !WAKE_PENDING.swap(true, Ordering::AcqRel)
+                            && event_loop.send_event(RuffleEvent::SkuaWake).is_err()
+                        {
+                            return;
+                        }
+                    }
+                    None => tracing::warn!("Skua bridge: bad message {line}"),
+                }
+            }
+            tracing::info!("Skua bridge closed, exiting");
+            let _ = event_loop.send_event(RuffleEvent::ExitRequested);
+        })?;
+    Ok(())
+}
+
+fn parse_call(line: &str) -> Option<SkuaCall> {
+    let msg: Json = serde_json::from_str(line).ok()?;
+    Some(SkuaCall {
+        id: msg.get("id")?.as_u64()?,
+        name: msg.get("name")?.as_str()?.to_string(),
+        args: match msg.get("args") {
+            Some(Json::Array(args)) => args.iter().map(from_json).collect(),
+            _ => Vec::new(),
+        },
+    })
+}
+
+fn lock<T>(mutex: &Mutex<T>) -> std::sync::MutexGuard<'_, T> {
+    mutex.lock().unwrap_or_else(|poisoned| poisoned.into_inner())
+}
+
+/// The calls received so far, for the main thread to run.
+pub fn take_calls() -> VecDeque<SkuaCall> {
+    std::mem::take(&mut *lock(&CALLS))
+}
+
+/// Called from `about_to_wait`: calls arriving from now on post a new wake.
+pub fn rearm() {
+    WAKE_PENDING.store(false, Ordering::Release);
+}
+
+pub fn reply(id: u64, result: ExternalValue) {
+    send(&json!({ "id": id, "r": to_json(&result) }));
+}
+
+fn send(msg: &Json) {
+    if let Some(writer) = WRITER.get() {
+        let mut writer = lock(writer);
+        if let Err(error) = writeln!(writer, "{msg}") {
+            tracing::warn!("Skua bridge: send failed: {error}");
+        }
+    }
+}
+
+fn to_json(value: &ExternalValue) -> Json {
+    match value {
+        ExternalValue::Undefined | ExternalValue::Null => Json::Null,
+        ExternalValue::Bool(b) => Json::Bool(*b),
+        // Whole numbers as integers, the way Flash's ExternalInterface printed them.
+        ExternalValue::Number(n) if n.fract() == 0.0 && n.abs() < 9.0e15 => Json::from(*n as i64),
+        ExternalValue::Number(n) => Number::from_f64(*n).map_or(Json::Null, Json::Number),
+        ExternalValue::String(s) => Json::String(s.clone()),
+        ExternalValue::List(list) => Json::Array(list.iter().map(to_json).collect()),
+        ExternalValue::Object(map) => Json::Object(
+            map.iter()
+                .map(|(key, value)| (key.clone(), to_json(value)))
+                .collect::<Map<_, _>>(),
+        ),
+    }
+}
+
+fn from_json(value: &Json) -> ExternalValue {
+    match value {
+        Json::Null => ExternalValue::Null,
+        Json::Bool(b) => ExternalValue::Bool(*b),
+        Json::Number(n) => ExternalValue::Number(n.as_f64().unwrap_or_default()),
+        Json::String(s) => ExternalValue::String(s.clone()),
+        Json::Array(list) => ExternalValue::List(list.iter().map(from_json).collect()),
+        Json::Object(map) => ExternalValue::Object(
+            map.iter()
+                .map(|(key, value)| (key.clone(), from_json(value)))
+                .collect(),
+        ),
+    }
+}
+
+/// Gives the keyboard to the player's window. Windows doesn't move focus to a child window when it
+/// is clicked (standard controls take it themselves), so without this Bonxie's window keeps it and
+/// the game gets no keys.
+#[cfg(windows)]
+pub fn take_focus(window: &winit::window::Window) {
+    use winit::raw_window_handle::{HasWindowHandle, RawWindowHandle};
+
+    #[link(name = "user32")]
+    unsafe extern "system" {
+        fn SetFocus(hwnd: isize) -> isize;
+    }
+
+    if let Ok(handle) = window.window_handle()
+        && let RawWindowHandle::Win32(handle) = handle.as_raw()
+    {
+        // SAFETY: SetFocus only takes the handle of this live window.
+        unsafe { SetFocus(handle.hwnd.get()) };
+    }
+}
+
+#[cfg(not(windows))]
+pub fn take_focus(window: &winit::window::Window) {
+    window.focus_window();
+}
+
+/// skua.swf's `ExternalInterface.call`s, forwarded to Bonxie as events.
+pub struct SkuaExternalInterface;
+
+impl ExternalInterfaceProvider for SkuaExternalInterface {
+    fn call_method(
+        &self,
+        _context: &mut UpdateContext<'_>,
+        name: &str,
+        args: &[ExternalValue],
+    ) -> ExternalValue {
+        match (name, args) {
+            ("skuaCall", [ExternalValue::String(event), rest @ ..]) => {
+                let args = match rest.first() {
+                    Some(ExternalValue::List(list)) => list.iter().map(to_json).collect(),
+                    _ => Vec::new(),
+                };
+                send(&json!({ "ev": event, "args": args }));
+            }
+            _ => tracing::warn!("Skua bridge: unknown ExternalInterface call {name}"),
+        }
+        ExternalValue::Undefined
+    }
+
+    fn on_callback_available(&self, _name: &str) {}
+
+    fn get_id(&self) -> Option<String> {
+        None
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn json_round_trip() {
+        let value = ExternalValue::List(vec![
+            ExternalValue::Number(5.0),
+            ExternalValue::Number(1.5),
+            ExternalValue::String("a\"b".into()),
+            ExternalValue::Bool(true),
+            ExternalValue::Null,
+        ]);
+        let json = to_json(&value);
+        assert_eq!(json.to_string(), r#"[5,1.5,"a\"b",true,null]"#);
+        assert_eq!(from_json(&json), value);
+    }
+
+    #[test]
+    fn parses_calls() {
+        let call = parse_call(r#"{"id":7,"name":"getGameObject","args":["world.myAvatar"]}"#)
+            .expect("valid call");
+        assert_eq!((call.id, call.name.as_str()), (7, "getGameObject"));
+        assert_eq!(call.args, vec![ExternalValue::String("world.myAvatar".into())]);
+        assert!(parse_call("not json").is_none());
+    }
+}
